 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<div class=\\\"print-heading\\\" style=\\\"display: flex; align-items: center; justify-content: space-between;\\\">\\n    \\n    <!-- Texto \\u00e0 esquerda -->\\n    <h2 style=\\\"margin: 0; flex: 1; text-align: left;\\\">\\n        <div>{{ _(doc.doctype) }}</div>\\n        <br>\\n        <small class=\\\"sub-heading\\\">{{ _(doc.name) }}</small>\\n        <br>\\n        <small class=\\\"sub-heading\\\">{{ _(doc.transaction_date) }}</small>\\n    </h2>\\n\\n    <!-- Imagem com link \\u00e0 direita -->\\n    <a href=\\\"https://seusite.com\\\" target=\\\"_blank\\\">\\n        <img \\n            src=\\\"https://yt3.googleusercontent.com/ytc/AIdro_kLILsv11XGXLYYsh4GvrH0gZ6pRXcn9B_5Ztn6fqhI9w=s900-c-k-c0x00ffffff-no-rj\\\" \\n            alt=\\\"Logo\\\"\\n            style=\\\"max-height: 70px; object-fit: contain;\\\"\\n        >\\n    </a>\\n\\n</div>\\n\\n<!--<div class=\\\"print-heading\\\">\\t\\t\\t\\t-->\\n<!--    <h2>-->\\n<!--        <div>Ordem de vendas</div>-->\\n<!--        <br>-->\\n<!--        <small class=\\\"sub-heading\\\">{{ _(doc.name) }}</small>-->\\n<!--        <br>-->\\n<!--        <small class=\\\"sub-heading\\\">{{ _(doc.transaction_date) }}</small>-->\\n<!--    </h2>-->\\n<!--</div>-->\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"customer\", \"print_hide\": 0, \"label\": \"Cliente\"}, {\"fieldname\": \"delivery_date\", \"print_hide\": 0, \"label\": \"Data de entrega\"}, {\"fieldname\": \"currency\", \"print_hide\": 0, \"label\": \"Moeda\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"company\", \"print_hide\": 0, \"label\": \"Empresa\"}, {\"fieldname\": \"company_address\", \"print_hide\": 0, \"label\": \"Nome do endere\\u00e7o da empresa\"}, {\"fieldname\": \"company_address_display\", \"print_hide\": 0, \"label\": \"Endere\\u00e7o da empresa\"}, {\"fieldtype\": \"Section Break\", \"label\": \"Items\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"scan_barcode\", \"print_hide\": 0, \"label\": \"Digitalize c\\u00f3digo de barras\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"items\", \"print_hide\": 0, \"label\": \"Unid\", \"visible_columns\": [{\"fieldname\": \"item_code\", \"print_width\": \"150px\", \"print_hide\": 0}, {\"fieldname\": \"ensure_delivery_based_on_produced_serial_no\", \"print_width\": \"\", \"print_hide\": 0}, {\"fieldname\": \"description\", \"print_width\": \"300px\", \"print_hide\": 0}, {\"fieldname\": \"image\", \"print_width\": \"\", \"print_hide\": 0}, {\"fieldname\": \"qty\", \"print_width\": \"100px\", \"print_hide\": 0}, {\"fieldname\": \"rate\", \"print_width\": \"100px\", \"print_hide\": 0}, {\"fieldname\": \"amount\", \"print_width\": \"100px\", \"print_hide\": 0}, {\"fieldname\": \"discount_percentage\", \"print_width\": \"\", \"print_hide\": 0}]}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"total\", \"print_hide\": 0, \"align\": \"left\", \"label\": \"Total\"}, {\"fieldname\": \"total_qty\", \"print_hide\": 0, \"label\": \"Quantidade total\"}, {\"fieldtype\": \"Section Break\", \"label\": \"Totals\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"grand_total\", \"print_hide\": 0, \"label\": \"Total geral\"}, {\"fieldname\": \"in_words\", \"print_hide\": 0, \"align\": \"right\", \"label\": \"Em palavras\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"rounded_total\", \"print_hide\": 0, \"label\": \"Total arredondado\"}, {\"fieldtype\": \"Section Break\", \"label\": \"Additional Discount\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"additional_discount_percentage\", \"print_hide\": 0, \"label\": \"Porcentagem de desconto adicional\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"discount_amount\", \"print_hide\": 0, \"label\": \"Valor de desconto adicional\"}, {\"fieldtype\": \"Section Break\", \"label\": \"Terms & Conditions\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"terms\", \"print_hide\": 0, \"label\": \"Detalhes dos termos e condi\\u00e7\\u00f5es\"}]",
 "html": "{% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\r\n{% set company_addr = frappe.get_doc(\"Address\", company_doc.company_address) if company_doc.company_address else None %}\r\n{% set customer_doc = frappe.get_doc(\"Customer\", doc.customer_name) if doc.customer_name else None %}\r\n{% set custumer_addr = frappe.get_doc(\"Address\", doc.customer_address) if doc.customer_address else None %}\r\n{% set partes = doc.in_words.split(\" \", 1) %}\r\n{% set moeda = partes[0] %}\r\n{% set valor = partes[1] | lower | replace(\" apenas.\", \"\") | replace(\" apenas\", \"\") %}\r\n\r\n<table class=\"table\" style=\"margin-top: 0; border-bottom: solid 1px #d1d8dd\">\r\n    <tbody>\r\n        <tr>\r\n            <td style=\"width: 50%; border: 0\">\r\n                <table class=\"table\" style=\"margin: 0\">\r\n                    <thead>\r\n                        <tr>\r\n                            <td style=\"border: 0; padding: 0 !important\">\r\n                                <h3 style=\"margin: 0\">{{ doc.company[:-2] }} {{ company_doc.country }}</h3>\r\n                            </td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td style=\"border: 0; padding: 0 !important\">\r\n                                <small>{{ company_doc.address_name or \"N/D\" }}</small>\r\n                            </td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td style=\"border: 0; padding: 0 !important\">\r\n                                <small>Telefone: {{ company_addr.phone or company_doc.phone_no or \"N/D\" }}</small>\r\n                            </td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td style=\"border: 0; padding: 0 !important\">\r\n                                <small>Email: {{ company_addr.email_id or company_doc.email or \"N/D\" }}</small>\r\n                            </td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td style=\"border: 0; padding: 0 !important\">\r\n                                <small>\r\n                                    Website:\r\n                                    <a href=\"{{ company_doc.website or 'https://www.logicpulse.com/pt/' }}\"\r\n                                        target=\"_blank\" class=\"text-info\">\r\n                                        <strong>logicpulse.com</strong>\r\n                                    </a>\r\n                                </small>\r\n                            </td>\r\n                        </tr>\r\n                    </thead>\r\n                </table>\r\n            </td>\r\n            <td style=\"width: 50%; border: 0\">\r\n                <table class=\"table\" style=\"margin: 0\">\r\n                    <thead>\r\n                        <tr>\r\n                            <td style=\"width: 30%; border: 0\"><img\r\n                                    src=\"{{ frappe.db.get_value('Company', doc.company, 'company_logo') or 'https://www.logicpulse.com/images/thumbs/0002017.png' }}\"\r\n                                    alt=\"\" style=\"height: 80px !important\" /></td>\r\n\r\n                        </tr>\r\n                    </thead>\r\n                </table>\r\n                <table class=\"table table-striped\" style=\"margin: 0\">\r\n                    <tbody>\r\n                        <tr>\r\n                            <th class=\"text-center\">{{ doc.select_print_heading or \"Ordem de Venda\" }}</th>\r\n                        </tr>\r\n                        <tr>\r\n                            <td class=\"text-center\">{{ doc.name }}</td>\r\n                        </tr>\r\n                    </tbody>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n<!-- <div class=\"row\">\r\n    <div class=\"col-md-12\">\r\n        <div>\r\n            <small>\u00c0 nossa considera\u00e7\u00e3o:</small>\r\n        </div>\r\n        <div style=\"text-indent: 40px; margin-top: 10px; text-align: justify\">\r\n            <small>Atendendo ao seu gentil pedido, temos o prazer de lhe enviar a cota\u00e7\u00e3o dos produtos solicitados,\r\n                conforme os seguintes detalhes:</small>\r\n        </div>\r\n    </div>\r\n</div> -->\r\n\r\n<table class=\"table table-striped\" style=\"margin-bottom: 0\">\r\n    <tbody>\r\n        <tr>\r\n            <!-- <th class=\"text-center\" width=\"15%\"><small>RUT</small></th> -->\r\n            <th class=\"text-center\" colspan=\"2\" width=\"45%\"><small>CLIENTE</small></th>\r\n            <!-- <th class=\"text-center\" width=\"25%\"><small>CONTACTO</small></th> -->\r\n            <th class=\"text-center\" width=\"25%\"><small>NIF</small></th>\r\n            <th class=\"text-center\" width=\"15%\"><small>DATA</small></th>\r\n            <th class=\"text-center\" width=\"15%\"><small>VALIDADE</small></th>\r\n        </tr>\r\n        <tr>\r\n            <!-- <td class=\"text-center\">\r\n                <small>\r\n                    {% if false and doc.quotation_to==\"Customer\" %}\r\n                    {{ frappe.db.get_value(\"Customer\", doc.customer_name, \"tax_id\") or \"\" }}\r\n                    {% endif %}\r\n                </small>\r\n            </td> -->\r\n            <td class=\"text-center\" colspan=\"2\"><small>{{ doc.customer_name }}</small></td>\r\n            <td class=\"text-center\"><small>{{ frappe.db.get_value(\"Customer\", doc.customer_name, \"fiscal_number\")\r\n                    }}</small></td>\r\n            <!-- {% if doc.contact_display %}\r\n            <td class=\"text-center\"><small>{{ doc.contact_display }}</small></td>\r\n            {% else %}\r\n            <td class=\"text-center\"><small>{{ frappe.db.get_value(\"Contact\", doc.contact_person, \"first_name\") or \"\" }}\r\n                    {{ frappe.db.get_value(\"Contact\", doc.contact_person, \"last_name\") or \"\" }}</small></td>\r\n            {% endif %} -->\r\n            <td class=\"text-center\"><small>{{ doc.get_formatted(\"transaction_date\") }}</small></td>\r\n            <td class=\"text-center\"><small>{{ doc.get_formatted(\"valid_till\") }}</small></td>\r\n        </tr>\r\n        <tr>\r\n            <th class=\"text-center\" width=\"15%\"><small>CIDADE</small></th>\r\n            <th class=\"text-center\" width=\"30%\"><small>ENDERE\u00c7O</small></th>\r\n            <!-- <th class=\"text-center\"><small>NIF</small></th> -->\r\n            <th class=\"text-center\" width=\"25%\"><small>CONTACTO</small></th>\r\n            <th class=\"text-center\" width=\"15%\"><small>DESCONTO</small></th>\r\n            <th class=\"text-center\" width=\"15%\"><small>T. PAGO</small></th>\r\n        </tr>\r\n        <tr>\r\n            {% if doc.customer_address %}\r\n            <td class=\"text-center\">\r\n                <small>{{ frappe.db.get_value(\"Address\", doc.customer_address, \"city\") or \"\" }}, {{\r\n                    frappe.db.get_value(\"Address\", doc.customer_address, \"country\") or \"\" }}</small>\r\n            </td>\r\n            {% else %}\r\n            <td class=\"text-center\"><small>&nbsp;</small></td>\r\n            {% endif %}\r\n            <!-- <td class=\"text-center\"><small>{{ frappe.db.get_value(\"Contact\", doc.contact_person, \"phone\") or \"\" }}</small></td> -->\r\n            <td class=\"text-center\"><small>{{ custumer_addr.address_line1 or \"N/D\" }}</small></td>\r\n\r\n            <!-- <td class=\"text-center\"><small>{{ frappe.db.get_value(\"Customer\", doc.customer_name, \"fiscal_number\") }}</small></td> -->\r\n            {% if doc.contact_display %}\r\n            <td class=\"text-center\"><small>{{ doc.contact_display }}</small></td>\r\n            {% else %}\r\n            <td class=\"text-center\"><small>{{ frappe.db.get_value(\"Contact\", doc.contact_person, \"first_name\") or \"\" }}\r\n                    {{ frappe.db.get_value(\"Contact\", doc.contact_person, \"last_name\") or \"\" }}</small></td>\r\n            {% endif %}\r\n            <td class=\"text-center\"><small>{{ doc.get_formatted(\"additional_discount_percentage\") }} %</small></td>\r\n            <td class=\"text-center\"><small>{{ frappe.db.get_value(\"Payment Terms Template\",\r\n                    doc.payment_terms_template,\"template_name\") or \"CONTADO\" }}</small></td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n<table class=\"table\">\r\n    <tbody>\r\n        <tr>\r\n            <td colspan=\"7\" class=\"text-left\"><strong><small>Moeda: {{ frappe.db.get_value(\"Currency\", doc.currency,\r\n                        \"currency_name\") }}</small></strong></td>\r\n        </tr>\r\n        <tr>\r\n            <!-- <th class=\"text-center\"><small>ARTIGO</small></th> -->\r\n            <th class=\"text-center\"><small>C\u00d3DIGO</small></th>\r\n            <th class=\"text-center\"><small>DESCRI\u00c7\u00c3O</small></th>\r\n            <th class=\"text-center\"><small>IMAGEM</small></th>\r\n            <th class=\"text-center\"><small>QUANTIDADE</small></th>\r\n            <th class=\"text-center\"><small>UNIT\u00c1RIO</small></th>\r\n            <th class=\"text-center\"><small>DESCONTO</small></th>\r\n            <th class=\"text-center\"><small>TOTAL</small></th>\r\n        </tr>\r\n        {%- for row in doc.items -%}\r\n        <tr>\r\n            <!-- <td style=\"width: 3%;\"><small>{{ row.idx }}</small></td> -->\r\n            <td style=\"width: 6%;\"><small>{{ row.item_code}}</small></td>\r\n            <td style=\"width: 30%;\">\r\n                <small>\r\n                    <div class=\"col-12\">{{ row.item_name }}</div>\r\n                    <!-- {% if row.description|striptags != '-' %}\r\n                    <div class=\"col-12\">{{ row.description }}</div>\r\n                    {% endif %} -->\r\n                </small>\r\n            </td>\r\n            <!-- <td style=\"width: 14%; text-align: right;\" class=\"text-center\"><small>{{ row.image if row.image else \"N/D\" }}</small></td> -->\r\n            <td style=\"width: 14%;\" class=\"text-center\">\r\n                {% if row.image %}\r\n                <img src=\"{{ row.image }}\" alt=\"{{ row.item_name }}\" width=\"42\" height=\"42\"\r\n                    style=\"vertical-align:middle\">\r\n                {% else %}\r\n                <small>N/D</small>\r\n                {% endif %}\r\n            </td>\r\n            <td style=\"width: 10%; text-align: right;\"><small>{{ row.qty }} {{ row.uom or row.stock_uom }}</small></td>\r\n            <td style=\"width: 15%; text-align: right;\"><small>{{ row.get_formatted(\"price_list_rate\", doc) }}</small>\r\n            </td>\r\n            <td style=\"width: 10%; text-align: right;\"><small>{{ row.discount_percentage }}%</small></td>\r\n            <!-- <td style=\"width: 15%; text-align: right;\"><small>{{ row.get_formatted(\"rate\", doc) }}</small></td> -->\r\n\r\n            <td style=\"width: 15%; text-align: right;\"><small>{{ row.get_formatted(\"amount\", doc) }}</small></td>\r\n        </tr>\r\n        {%- endfor -%}\r\n        <tr>\r\n            <td colspan=\"6\" class=\"text-right\"><strong>SUB-TOTAL</strong></td>\r\n            <td class=\"text-right\"><small>{{ doc.get_formatted(\"total\") }}</small></td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"6\" class=\"text-right\"><strong>TOTAL DE DESCONTOS</strong></td>\r\n            <td class=\"text-right\"><small>{{ doc.get_formatted(\"discount_amount\") }}</small></td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"6\" class=\"text-right\"><strong>TOTAL L\u00cdQUIDO</strong></td>\r\n            <td class=\"text-right\"><small>{{ doc.get_formatted(\"net_total\") }}</small></td>\r\n        </tr>\r\n        {%- for row in doc.taxes -%}\r\n        <tr>\r\n            <!-- <td colspan=\"5\" class=\"text-right\"><strong>{{ row.description }} {{ row.rate }}%</strong></td> -->\r\n            <td colspan=\"6\" class=\"text-right\"><strong>IMPOSTO {{ row.rate }}%</strong></td>\r\n            <td class=\"text-right\"><small>{{ row.get_formatted(\"tax_amount\", doc) }}</small></td>\r\n        </tr>\r\n        {%- endfor -%}\r\n        <tr>\r\n            <td colspan=\"6\" class=\"text-right\"><strong>TOTAL</strong></td>\r\n            {% if doc.rounded_total == 0 %}\r\n            <td class=\"text-right\"><strong><small>{{ doc.get_formatted(\"grand_total\") }}</small></strong>\r\n                {% else %}\r\n            <td class=\"text-right\"><strong><small>{{ doc.get_formatted(\"rounded_total\") }}</small></strong></td>\r\n            {% endif %}\r\n        </tr>\r\n        <tr>\r\n            <!-- <td colspan=\"6\" class=\"text-right\"><strong><small>Por extenso: {{ moeda }} {{ valor | capitalize }}.</small></strong></td> -->\r\n            <td colspan=\"7\" class=\"text-right\"><strong><small>Por extenso: {{ moeda }} {{ valor | capitalize\r\n                        }}.</small></strong></td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n{% if doc.terms %}\r\n<div class=\"page-break\"></div>\r\n<div class=\"panel panel-default\">\r\n    <div class=\"panel-heading\"><strong><small>Termos e Condi\u00e7\u00f5es</small></strong></div>\r\n    <div class=\"panel-body\"><small>{{ doc.terms }}</small></div>\r\n</div>\r\n{% endif %}\r\n\r\n<footer class=\"footer-fixo\">\r\n    <div class=\"row\">\r\n        <div class=\"col-md-12 text-center\">\r\n            <small>Este documento n\u00e3o serve de fatura</small>\r\n        </div>\r\n</footer>\r\n\r\n<!-- <div class=\"row\">\r\n    <div class=\"col-md-12\">\r\n        <small>Esperamos uma boa recep\u00e7\u00e3o e colocando desde j\u00e1 a nossa empresa ao seu servi\u00e7o, despedimo-nos\r\n            atentamente,</small>\r\n    </div>\r\n</div>\r\n<div class=\"row\">\r\n    <table class=\"table\" style=\"margin-top: 0;\">\r\n        <tbody>\r\n            <tr>\r\n                <td style=\"width: 70%; border: 0\"></td>\r\n                <td style=\"width: 30%; border: 0\"><small>{{ frappe.db.get_value(\"User\", doc.owner, \"full_name\") }}\r\n                <br />{{ frappe.db.get_value(\"User\", doc.owner, \"name\") }}</small></td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n</div> -->\r\n\r\n<!-- {% if doc.detail %}\r\n<div class=\"page-break\"></div>\r\n<div class=\"row text-center\">\r\n    <h1><strong>Requerimientos</strong></h1>\r\n</div>\r\n<div class=\"row\" style=\"margin-top: 20px\">\r\n    <div class=\"col-md-12\">{{ doc.detail }}</div>\r\n</div>\r\n{% if doc.solution %}\r\n<div class=\"row text-center\">\r\n    <h1><strong>Soluci\u00f3n Propuesta</strong></h1>\r\n</div>\r\n<div class=\"row\" style=\"margin-top: 20px\">\r\n    <div class=\"col-md-12\">{{ doc.solution }}</div>\r\n</div>\r\n{% endif %}\r\n{% endif %} -->",
